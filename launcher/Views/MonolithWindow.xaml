<Window x:Class="Monolith.Views.MonolithWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Monolith Desktop Environment"
        Width="1040"
        Height="740"
        MinWidth="880"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0A0A0C"
        Foreground="#FFFFFF"
        WindowStyle="None"
        AllowsTransparency="False">

    <Window.Resources>
        <SolidColorBrush x:Key="OledDark" Color="#0A0A0C"/>
        <SolidColorBrush x:Key="CardBackground" Color="#121217"/>
        <SolidColorBrush x:Key="CardElevated" Color="#1C1C24"/>
        <SolidColorBrush x:Key="CardBorder" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#00E5FF"/>
        <SolidColorBrush x:Key="TextDim" Color="#88FFFFFF"/>

        <!-- Custom Accent Button -->
        <Style x:Key="CyanButton" TargetType="Button">
            <Setter Property="Background" Value="#00E5FF"/>
            <Setter Property="Foreground" Value="#0A0A0C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Secondary Button -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#1C1C24"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ToggleSwitch Style -->
        <Style x:Key="ModernToggle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Track" Width="44" Height="22" CornerRadius="11" Background="#33FFFFFF" Cursor="Hand">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#00E5FF"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#0A0A0C"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation Tab Button Style -->
        <Style x:Key="NavTabRadio" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#88FFFFFF"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2400E5FF"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container -->
    <Grid Background="{StaticResource OledDark}">
        <Grid.RowDefinitions>
            <!-- Title Bar -->
            <RowDefinition Height="46"/>
            <!-- Hero Master Services Toggles Banner -->
            <RowDefinition Height="Auto"/>
            <!-- Content Area: Left Nav + Pages -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Background="#0A0A0C" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource AccentCyan}" Margin="0,0,10,0">
                        <TextBlock Text="M" Foreground="#0A0A0C" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="MONOLITH" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <TextBlock Text="|" Foreground="#33FFFFFF" Margin="10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Unified Desktop Environment" FontSize="12" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="-" Style="{StaticResource DarkButton}" Padding="10,2" Margin="2,0" Click="MinimizeButton_Click"/>
                    <Button Content="✕" Style="{StaticResource DarkButton}" Padding="10,2" Margin="2,0" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Hero Master Services Toggles Banner -->
        <Border Grid.Row="1" Background="#0E0E13" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tiler Master Card -->
                <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="18,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📐 Monolith Tiler" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <Border Background="#1C1C24" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TilerStatusText}" Foreground="{Binding TilerStatusColor}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Win11 Native Virtual Desktop Tiling Core" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Master Toggle Tiler -->
                            <CheckBox Grid.Column="1" Style="{StaticResource ModernToggle}" IsChecked="{Binding IsTilerEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding TilerTelemetry}" FontSize="12" Foreground="#00E5FF" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Restart Tiler" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="11" Click="RestartTiler_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Launcher Master Card -->
                <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="18,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍 Monolith Launcher" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <Border Background="#1C1C24" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LauncherStatusText}" Foreground="{Binding LauncherStatusColor}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Instant Acrylic Command Palette (Alt + Space)" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Master Toggle Launcher -->
                            <CheckBox Grid.Column="1" Style="{StaticResource ModernToggle}" IsChecked="{Binding IsLauncherEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Global Hotkey: Alt + Space" FontSize="12" Foreground="#88FFFFFF" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Open Palette (Alt+Space)" Style="{StaticResource CyanButton}" Padding="10,4" FontSize="11" Click="OpenPalette_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Body: Navigation Sidebar + Tab Content Pages -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar -->
            <Border Grid.Column="0" Background="#0C0C10" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0" Padding="10,16">
                <StackPanel>
                    <TextBlock Text="SETTINGS &amp; CONFIG" FontSize="10.5" FontWeight="Bold" Foreground="#55FFFFFF" Margin="12,0,0,10"/>
                    <RadioButton Content="⚙️  General &amp; Services" Style="{StaticResource NavTabRadio}" IsChecked="True" Checked="TabRadio_Checked" Tag="0"/>
                    <RadioButton Content="🔲  Workspaces" Style="{StaticResource NavTabRadio}" Checked="TabRadio_Checked" Tag="1"/>
                    <RadioButton Content="📐  Tiling &amp; Layout" Style="{StaticResource NavTabRadio}" Checked="TabRadio_Checked" Tag="2"/>
                    <RadioButton Content="📋  Window Rules" Style="{StaticResource NavTabRadio}" Checked="TabRadio_Checked" Tag="3"/>
                    <RadioButton Content="🎨  Appearance &amp; Themes" Style="{StaticResource NavTabRadio}" Checked="TabRadio_Checked" Tag="4"/>
                    <RadioButton Content="⌨️  Hotkeys" Style="{StaticResource NavTabRadio}" Checked="TabRadio_Checked" Tag="5"/>
                </StackPanel>
            </Border>

            <!-- Tab Content Pages Container -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,20">
                <Grid>
                    <!-- PAGE 0: General & Services -->
                    <StackPanel x:Name="PageGeneral"  Visibility="Visible">
                        <TextBlock Text="General &amp; Services Configuration" FontSize="22" FontWeight="Bold"/>

                        <!-- Process & Startup -->
                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel >
                                <TextBlock Text="System Integration" FontSize="15" FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Enable Monolith on Windows Startup" FontSize="13.5"/><TextBlock Text="Start Monolith background supervisor when logging in." FontSize="11.5" Foreground="{StaticResource TextDim}"/></StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ModernToggle}" IsChecked="{Binding Config.EngineStartup, Mode=TwoWay}" Click="OnSettingChanged"/>
                                </Grid>
                                <Rectangle Height="1" Fill="#14FFFFFF"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Run with Elevated Administrator Privileges" FontSize="13.5"/><TextBlock Text="Allows window tiling to manage elevated task manager and admin tools." FontSize="11.5" Foreground="{StaticResource TextDim}"/></StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ModernToggle}" IsChecked="{Binding Config.RunLauncherAdmin, Mode=TwoWay}" Click="OnSettingChanged"/>
                                </Grid>
                                <Rectangle Height="1" Fill="#14FFFFFF"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Auto-Hide Windows Taskbar" FontSize="13.5"/><TextBlock Text="Maximize usable tiling display canvas." FontSize="11.5" Foreground="{StaticResource TextDim}"/></StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ModernToggle}" IsChecked="{Binding Config.HideTaskbar, Mode=TwoWay}" Click="OnSettingChanged"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Diagnostics -->
                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel >
                                <TextBlock Text="Diagnostics &amp; Logs" FontSize="15" FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Diagnostic Log File" FontSize="13.5"/><TextBlock Text="View real-time event logs in %APPDATA%\Monolith\monolith.log" FontSize="11.5" Foreground="{StaticResource TextDim}"/></StackPanel>
                                    <Button Grid.Column="1" Content="View Log File" Style="{StaticResource DarkButton}" Click="ViewLogFile_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- PAGE 1: Workspaces -->
                    <StackPanel x:Name="PageWorkspaces"  Visibility="Collapsed">
                        <TextBlock Text="Workspaces &amp; Virtual Desktops" FontSize="22" FontWeight="Bold"/>

                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel >
                                <TextBlock Text="Native Desktop Provisions" FontSize="15" FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Default Workspace Count" FontSize="13.5"/><TextBlock Text="Number of virtual desktops provisioned on Windows startup (1–10)." FontSize="11.5" Foreground="{StaticResource TextDim}"/></StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Slider Width="140" Minimum="1" Maximum="10" Value="{Binding Config.DefaultWorkspaceCount, Mode=TwoWay}" ValueChanged="OnSliderChanged"/>
                                        <TextBlock Text="{Binding Config.DefaultWorkspaceCount}" Width="24" FontWeight="Bold" Foreground="#00E5FF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Rectangle Height="1" Fill="#14FFFFFF"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Wrap Around Workspaces" FontSize="13.5"/><TextBlock Text="Cycling next from the final desktop loops directly back to workspace 1." FontSize="11.5" Foreground="{StaticResource TextDim}"/></StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ModernToggle}" IsChecked="{Binding Config.WrapAround, Mode=TwoWay}" Click="OnSettingChanged"/>
                                </Grid>
                                <Rectangle Height="1" Fill="#14FFFFFF"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Focus Follows Cursor Across Monitors" FontSize="13.5"/><TextBlock Text="Shift active window focus automatically as the mouse crosses displays." FontSize="11.5" Foreground="{StaticResource TextDim}"/></StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ModernToggle}" IsChecked="{Binding Config.FocusFollowsCursor, Mode=TwoWay}" Click="OnSettingChanged"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- PAGE 2: Tiling & Layout -->
                    <StackPanel x:Name="PageTiling"  Visibility="Collapsed">
                        <TextBlock Text="Tiling &amp; Layout Algorithms" FontSize="22" FontWeight="Bold"/>

                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel >
                                <TextBlock Text="Default Window Partitioning" FontSize="15" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Binary Space Partitioning (BSP)" Margin="0,0,16,0" IsChecked="True" Foreground="#FFFFFF" Tag="BSP" Checked="LayoutRadio_Checked"/>
                                    <RadioButton Content="Columns" Margin="0,0,16,0" Foreground="#FFFFFF" Tag="Columns" Checked="LayoutRadio_Checked"/>
                                    <RadioButton Content="Rows" Margin="0,0,16,0" Foreground="#FFFFFF" Tag="Rows" Checked="LayoutRadio_Checked"/>
                                    <RadioButton Content="Floating" Foreground="#FFFFFF" Tag="Floating" Checked="LayoutRadio_Checked"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel >
                                <TextBlock Text="Gaps &amp; Spacing Dimensions (px)" FontSize="15" FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="Outer Top" FontSize="11.5" Foreground="{StaticResource TextDim}"/><TextBox Text="{Binding Config.OuterGapsTop, Mode=TwoWay}" Background="#1C1C24" Foreground="#FFFFFF" BorderBrush="#33FFFFFF" Padding="6,4" TextChanged="OnTextChanged"/></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Outer Bottom" FontSize="11.5" Foreground="{StaticResource TextDim}"/><TextBox Text="{Binding Config.OuterGapsBottom, Mode=TwoWay}" Background="#1C1C24" Foreground="#FFFFFF" BorderBrush="#33FFFFFF" Padding="6,4" TextChanged="OnTextChanged"/></StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Outer Left" FontSize="11.5" Foreground="{StaticResource TextDim}"/><TextBox Text="{Binding Config.OuterGapsLeft, Mode=TwoWay}" Background="#1C1C24" Foreground="#FFFFFF" BorderBrush="#33FFFFFF" Padding="6,4" TextChanged="OnTextChanged"/></StackPanel>
                                    <StackPanel Grid.Column="3" Margin="8,0,0,0"><TextBlock Text="Outer Right" FontSize="11.5" Foreground="{StaticResource TextDim}"/><TextBox Text="{Binding Config.OuterGapsRight, Mode=TwoWay}" Background="#1C1C24" Foreground="#FFFFFF" BorderBrush="#33FFFFFF" Padding="6,4" TextChanged="OnTextChanged"/></StackPanel>
                                </Grid>
                                <Rectangle Height="1" Fill="#14FFFFFF"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Inner Gaps (Window-to-Window)" FontSize="13.5"/><TextBlock Text="Spacing between adjacent tiled windows." FontSize="11.5" Foreground="{StaticResource TextDim}"/></StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding Config.InnerGaps, Mode=TwoWay}" Background="#1C1C24" Foreground="#FFFFFF" BorderBrush="#33FFFFFF" Padding="6,4" TextChanged="OnTextChanged"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- PAGE 3: Window Rules -->
                    <StackPanel x:Name="PageRules"  Visibility="Collapsed">
                        <TextBlock Text="Window Rules &amp; Application Routing" FontSize="22" FontWeight="Bold"/>

                        <!-- Rule Creator -->
                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel >
                                <TextBlock Text="Add Window Rule" FontSize="15" FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="Process Name" FontSize="11.5" Foreground="{StaticResource TextDim}"/><TextBox x:Name="InputRuleProc" Text="spotify.exe" Background="#1C1C24" Foreground="#FFFFFF" BorderBrush="#33FFFFFF" Padding="6,4"/></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Action" FontSize="11.5" Foreground="{StaticResource TextDim}"/><ComboBox x:Name="InputRuleAction" SelectedIndex="0" Background="#1C1C24" Foreground="#000000" Padding="6,4"><ComboBoxItem Content="Force Tile"/><ComboBoxItem Content="Force Float"/><ComboBoxItem Content="Send to Workspace"/></ComboBox></StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Workspace (1-10)" FontSize="11.5" Foreground="{StaticResource TextDim}"/><TextBox x:Name="InputRuleWs" Text="4" Background="#1C1C24" Foreground="#FFFFFF" BorderBrush="#33FFFFFF" Padding="6,4"/></StackPanel>
                                    <Button Grid.Column="3" Content="+ Add Rule" Style="{StaticResource CyanButton}" Margin="12,16,0,0" VerticalAlignment="Bottom" Click="AddRule_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Rule List -->
                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel >
                                <TextBlock Text="Active Rules" FontSize="15" FontWeight="SemiBold"/>
                                <ItemsControl ItemsSource="{Binding WindowRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#16161D" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ProcessName}" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Action}" Foreground="#00E5FF" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding TargetWorkspace, StringFormat='Workspace {0}'}" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="3" Content="Delete" Style="{StaticResource DarkButton}" Foreground="#FF5252" Padding="8,2" FontSize="11" Click="DeleteRule_Click" Tag="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- PAGE 4: Appearance -->
                    <StackPanel x:Name="PageAppearance"  Visibility="Collapsed">
                        <TextBlock Text="Appearance &amp; Themes" FontSize="22" FontWeight="Bold"/>

                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel >
                                <TextBlock Text="Active Focus Border" FontSize="15" FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Enable Active Window Border" FontSize="13.5"/><TextBlock Text="Composites a hardware border around the focused window." FontSize="11.5" Foreground="{StaticResource TextDim}"/></StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ModernToggle}" IsChecked="{Binding Config.EnableActiveBorder, Mode=TwoWay}" Click="OnSettingChanged"/>
                                </Grid>
                                <Rectangle Height="1" Fill="#14FFFFFF"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Active Border Color (Hex)" FontSize="13.5" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding Config.ActiveBorderColor, Mode=TwoWay}" Background="#1C1C24" Foreground="#FFFFFF" BorderBrush="#33FFFFFF" Padding="6,4" TextChanged="OnTextChanged"/>
                                </Grid>
                                <Rectangle Height="1" Fill="#14FFFFFF"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Border Thickness (px)" FontSize="13.5" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Slider Width="140" Minimum="1" Maximum="8" Value="{Binding Config.BorderThickness, Mode=TwoWay}" ValueChanged="OnSliderChanged"/>
                                        <TextBlock Text="{Binding Config.BorderThickness}" Width="24" FontWeight="Bold" Foreground="#00E5FF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- PAGE 5: Hotkeys -->
                    <StackPanel x:Name="PageHotkeys"  Visibility="Collapsed">
                        <TextBlock Text="Keyboard Shortcuts &amp; Hotkeys" FontSize="22" FontWeight="Bold"/>

                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel >
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="System-Wide Hotkeys" FontSize="15" FontWeight="SemiBold"/>
                                    <Button Grid.Column="1" Content="Reset All to Default" Style="{StaticResource DarkButton}" Click="ResetHotkeys_Click"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding HotkeyBindings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#16161D" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Category}" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Action}" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" Content="{Binding Binding}" Style="{StaticResource DarkButton}" Foreground="#00E5FF" FontFamily="Consolas" Padding="8,4" HorizontalAlignment="Right" Click="EditHotkey_Click" Tag="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Status Footer -->
        <Border Grid.Row="3" Background="#0A0A0C" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{Binding IpcStatusColor}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding IpcStatusText}" FontSize="11.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                    <TextBlock Text="•" Foreground="#33FFFFFF" Margin="8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Monolith Desktop Environment 1.0 (All-in-One Native)" FontSize="11" Foreground="#44FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Save Changes" Style="{StaticResource CyanButton}" Padding="12,4" FontSize="11" Click="SaveConfig_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
