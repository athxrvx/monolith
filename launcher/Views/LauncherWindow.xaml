<Window x:Class="Monolith.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Monolith Launcher"
        Width="620"
        MaxHeight="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="True"
        RenderTransformOrigin="0.5, 0.5"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.RenderTransform>
        <TransformGroup>
            <ScaleTransform x:Name="WindowScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
            <TranslateTransform x:Name="WindowTranslateTransform" Y="0"/>
        </TransformGroup>
    </Window.RenderTransform>

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceTint" Color="#F016191D"/>
        <SolidColorBrush x:Key="BorderTint" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#60CDFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F2FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#80FFFFFF"/>
        <SolidColorBrush x:Key="ItemHoverBackground" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="ItemSelectedBackground" Color="#2460CDFF"/>

        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="6,1,6,1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="9,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource ItemHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource ItemSelectedBackground}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#4060CDFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border x:Name="RootBorder"
                Background="{StaticResource SurfaceTint}"
                BorderBrush="{StaticResource BorderTint}"
                BorderThickness="1"
                CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="32"
                                  ShadowDepth="0"
                                  Opacity="0.55"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search Input Row -->
                <Grid Grid.Row="0" Margin="13,8,13,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0"
                          VerticalAlignment="Center"
                          Margin="4,0,12,0"
                          Width="18"
                          Height="18"
                          Stretch="Uniform"
                          Fill="{StaticResource AccentCyan}"
                          Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>

                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextPrimary}"
                             CaretBrush="{StaticResource AccentCyan}"
                             Height="34"
                             Padding="0"
                             FontSize="15"
                             FontFamily="Segoe UI Variable Text, Segoe UI"
                             FontWeight="Normal"
                             VerticalAlignment="Center"
                             TextChanged="SearchBox_TextChanged"/>

                    <TextBlock Grid.Column="1"
                               x:Name="SearchPlaceholder"
                               Text="Search apps and tools"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="15"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               VerticalAlignment="Center"
                               Margin="2,0,0,0"
                               IsHitTestVisible="False"/>

                </Grid>

                <Rectangle Grid.Row="0" Height="1" Fill="#16FFFFFF" VerticalAlignment="Bottom"/>

                <!-- Results List -->
                <ListBox x:Name="ResultsList"
                         Grid.Row="1"
                         MaxHeight="330"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionMode="Single"
                         MouseDoubleClick="ResultsList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0"
                                       Source="{Binding Icon}"
                                       Width="22"
                                       Height="22"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                <StackPanel Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="#F2FFFFFF"
                                               FontSize="13"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}"
                                               Foreground="#70FFFFFF"
                                               FontSize="10.5"
                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,1,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="2"
                                        Background="#0FFFFFFF"
                                        CornerRadius="4"
                                        Padding="5,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Category}"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="9.5"
                                               FontWeight="Medium"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyState"
                           Grid.Row="1"
                           Text="Loading apps…"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           IsHitTestVisible="False"/>

                <!-- Footer Status Bar -->
                <Border Grid.Row="2"
                        Background="#40050507"
                        BorderBrush="#14FFFFFF"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,9,9"
                        Padding="13,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ResultCountText"
                                   Grid.Column="0"
                                   Text=""
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="10.5"/>
                        <TextBlock Grid.Column="1"
                                   Text="↑↓ Navigate    ↵ Launch    Esc Close"
                                   Foreground="#70FFFFFF"
                                   FontSize="10.5"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

