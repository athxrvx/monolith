<Page
    x:Class="Monolith.Studio.Views.MonoDockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,40,40">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="MonoDock" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="A macOS-inspired dock for pinned apps, with launch indicators and window controls." FontSize="14" Opacity="0.72" TextWrapping="Wrap" />
            </StackPanel>
            <controls:SettingsCard Header="Show MonoDock" Description="Keep the dock centered along the bottom of your screen while Monolith is enabled." HeaderIcon="{ui:FontIcon Glyph=&#xE8A1;}">
                <ToggleSwitch x:Name="EnabledToggle" OnContent="On" OffContent="Off" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Icon size" Description="Set the dock icon size in pixels." HeaderIcon="{ui:FontIcon Glyph=&#xE8A5;}">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Slider x:Name="IconSizeSlider" Width="220" Minimum="40" Maximum="88" StepFrequency="4" />
                    <TextBlock x:Name="IconSizeValue" Foreground="{StaticResource AccentBlueBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </controls:SettingsCard>
            <controls:SettingsCard Header="Pinned apps" Description="Enter one application path, executable name, or shell target per line. Click an icon in the dock to open it." HeaderIcon="{ui:FontIcon Glyph=&#xE71D;}">
                <TextBox x:Name="PinnedAppsBox" Width="420" MinHeight="132" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="explorer.exe&#10;msedge.exe&#10;notepad.exe&#10;wt.exe" />
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
