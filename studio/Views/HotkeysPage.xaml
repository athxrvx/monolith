<Page
    x:Class="Monolith.Studio.Views.HotkeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:models="using:Monolith.Studio.Models">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,40,40">
        <StackPanel Spacing="18" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="Keyboard Shortcuts &amp; Hotkeys" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Bind window controls, Monolith workspace navigation, or launch any program or shell command." FontSize="14" Opacity="0.72" />
            </StackPanel>

            <controls:SettingsCard Header="Interactive hotkey remapping"
                                   Description="Edit shortcuts, choose a built-in window action, or launch your own program and command."
                                   HeaderIcon="{ui:FontIcon Glyph=&#xE765;}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Add binding" Style="{StaticResource AccentButtonStyle}" Click="AddHotkey_Click" />
                    <Button Content="Reset defaults" Click="ResetHotkeys_Click" />
                </StackPanel>
            </controls:SettingsCard>

            <TextBlock Text="Keyboard shortcuts" FontSize="18" FontWeight="SemiBold" Margin="2,8,0,0" />
            <ListView x:Name="HotkeysListView"
                      ItemsSource="{x:Bind ViewModel.HotkeyBindings, Mode=OneWay}"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:HotkeyBinding">
                        <controls:SettingsCard Header="{x:Bind Action}"
                                               Description="{x:Bind Category}"
                                               HeaderIcon="{ui:FontIcon Glyph=&#xE765;}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{x:Bind Binding}"
                                        Tag="{x:Bind}"
                                        Click="BindingButton_Click"
                                        Background="#292929"
                                        BorderBrush="#4D00E5FF"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Foreground="#60CDFF"
                                        FontFamily="Consolas, Segoe UI"
                                        FontWeight="SemiBold"
                                        Padding="10,4" />
                                <Button Content="Remove" Tag="{x:Bind}" Click="RemoveHotkey_Click" Padding="8,4" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
