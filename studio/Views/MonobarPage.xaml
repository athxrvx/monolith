<Page
    x:Class="Monolith.Studio.Views.MonobarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Monolith.Studio.Models"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,40,40">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="Monobar" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Build a top bar that fits your workflow. Enable modules, arrange their order, and place them on either side or in the center." FontSize="14" Opacity="0.72" TextWrapping="Wrap" />
            </StackPanel>
            <controls:SettingsCard Header="Show Monobar" Description="Keep Monobar visible while Monolith is enabled." HeaderIcon="{ui:FontIcon Glyph=&#xE8A7;}">
                <ToggleSwitch x:Name="EnabledToggle" OnContent="On" OffContent="Off" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Bar height" Description="Set the top bar height in pixels." HeaderIcon="{ui:FontIcon Glyph=&#xE744;}">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Slider x:Name="HeightSlider" Width="220" Minimum="28" Maximum="64" StepFrequency="2" />
                    <TextBlock x:Name="HeightValue" Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </controls:SettingsCard>
            <controls:SettingsCard Header="Backdrop material" Description="Choose the appearance of the bar surface." HeaderIcon="{ui:FontIcon Glyph=&#xE7F4;}">
                <ComboBox x:Name="MaterialCombo" Width="220">
                    <x:String>Acrylic (Frosted Glass)</x:String>
                    <x:String>Pure OLED Dark</x:String>
                </ComboBox>
            </controls:SettingsCard>
            <Grid Margin="2,12,0,0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBlock Text="Applet layout" FontSize="20" FontWeight="SemiBold" />
                <Button Grid.Column="1" Content="Add applet" Click="AddAppletClicked">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="A" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>
            </Grid>
            <TextBlock Text="Drag applets between Left, Center, and Right. Use the gear to configure an applet or the trash button to remove it." Opacity="0.72" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
                <StackPanel Grid.Column="0" Spacing="8">
                    <TextBlock Text="Left section" FontSize="15" FontWeight="SemiBold" />
                    <Grid>
                    <ListView x:Name="LeftModulesList" SelectionMode="None" CanDragItems="True" AllowDrop="True" CanReorderItems="False" DragItemsStarting="ModuleDragItemsStarting" DragOver="ModuleDragOver" DragLeave="ModuleDragLeave" Drop="LeftLaneDrop">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:MonobarModuleConfig">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="9" Padding="8" Margin="0,0,0,5">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="7">
                                        <TextBlock Text="&#x2261;" FontSize="18" VerticalAlignment="Center" Opacity="0.7" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="15" />
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Description}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2" Tag="{x:Bind}" Click="ModuleSettingsClicked" ToolTipService.ToolTip="Applet settings" Padding="7" MinWidth="0">
                                            <FontIcon Glyph="&#xE713;" FontSize="13" />
                                        </Button>
                                        <Button Grid.Column="3" Tag="{x:Bind}" Click="RemoveAppletClicked" ToolTipService.ToolTip="Remove applet" Padding="7" MinWidth="0">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                        <Border x:Name="LeftDropIndicator" Height="2" Background="{StaticResource AccentBlueBrush}" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="8,0,8,0" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="Center section" FontSize="15" FontWeight="SemiBold" />
                    <Grid>
                    <ListView x:Name="CenterModulesList" SelectionMode="None" CanDragItems="True" AllowDrop="True" CanReorderItems="False" DragItemsStarting="ModuleDragItemsStarting" DragOver="ModuleDragOver" DragLeave="ModuleDragLeave" Drop="CenterLaneDrop">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:MonobarModuleConfig">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="9" Padding="8" Margin="0,0,0,5">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="7">
                                        <TextBlock Text="&#x2261;" FontSize="18" VerticalAlignment="Center" Opacity="0.7" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="15" />
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Description}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2" Tag="{x:Bind}" Click="ModuleSettingsClicked" ToolTipService.ToolTip="Applet settings" Padding="7" MinWidth="0">
                                            <FontIcon Glyph="&#xE713;" FontSize="13" />
                                        </Button>
                                        <Button Grid.Column="3" Tag="{x:Bind}" Click="RemoveAppletClicked" ToolTipService.ToolTip="Remove applet" Padding="7" MinWidth="0">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                        <Border x:Name="CenterDropIndicator" Height="2" Background="{StaticResource AccentBlueBrush}" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="8,0,8,0" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="8">
                    <TextBlock Text="Right section" FontSize="15" FontWeight="SemiBold" />
                    <Grid>
                    <ListView x:Name="RightModulesList" SelectionMode="None" CanDragItems="True" AllowDrop="True" CanReorderItems="False" DragItemsStarting="ModuleDragItemsStarting" DragOver="ModuleDragOver" DragLeave="ModuleDragLeave" Drop="RightLaneDrop">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:MonobarModuleConfig">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="9" Padding="8" Margin="0,0,0,5">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="7">
                                        <TextBlock Text="&#x2261;" FontSize="18" VerticalAlignment="Center" Opacity="0.7" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="15" />
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Description}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2" Tag="{x:Bind}" Click="ModuleSettingsClicked" ToolTipService.ToolTip="Applet settings" Padding="7" MinWidth="0">
                                            <FontIcon Glyph="&#xE713;" FontSize="13" />
                                        </Button>
                                        <Button Grid.Column="3" Tag="{x:Bind}" Click="RemoveAppletClicked" ToolTipService.ToolTip="Remove applet" Padding="7" MinWidth="0">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                        <Border x:Name="RightDropIndicator" Height="2" Background="{StaticResource AccentBlueBrush}" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="8,0,8,0" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>



