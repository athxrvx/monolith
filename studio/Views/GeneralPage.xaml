<Page
    x:Class="Monolith.Studio.Views.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,40,40">
        <StackPanel Spacing="18" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4" Margin="0,0,0,4">
                <TextBlock Text="General Settings" FontSize="30" FontWeight="SemiBold" Foreground="#FFFFFF" />
                <TextBlock Text="Manage Monolith.Engine runtime, system startup, and diagnostics." FontSize="14" Foreground="#A0FFFFFF" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Engine" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,2" />

                <controls:SettingsCard Header="Monolith Engine"
                                       Description="Core window management and Monolith workspace service."
                                       HeaderIcon="{ui:FontIcon Glyph=&#xE9F5;}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="{x:Bind ViewModel.EngineStatusColor, Mode=OneWay}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.EngineStatusText, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="PID" FontSize="11" Foreground="#B8FFFFFF" />
                        <TextBlock Text="{x:Bind ViewModel.EnginePid, Mode=OneWay}" FontSize="11" Foreground="#B8FFFFFF" />
                        <TextBlock Text="RAM" FontSize="11" Foreground="#B8FFFFFF" />
                        <TextBlock Text="{x:Bind ViewModel.EngineRamUsage, Mode=OneWay}" FontSize="11" Foreground="#B8FFFFFF" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard Header="Launch engine at sign-in"
                                       Description="Start Monolith automatically when you sign in to Windows."
                                       HeaderIcon="{ui:FontIcon Glyph=&#xE713;}">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Config.EngineStartup, Mode=TwoWay}" Toggled="OnSettingChanged" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="Engine controls"
                                       Description="Restart, stop, or reload the active configuration."
                                       HeaderIcon="{ui:FontIcon Glyph=&#xE768;}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Restart" Style="{StaticResource AccentButtonStyle}" Click="RestartEngine_Click" />
                        <Button Content="Stop" Click="StopEngine_Click" />
                        <Button Content="Reload config" Click="ReloadConfig_Click" />
                    </StackPanel>
                </controls:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="System integration" FontSize="18" FontWeight="SemiBold" Margin="2,8,0,2" />

                <controls:SettingsCard Header="Run launcher as administrator"
                                       Description="Allow the command palette to interact with elevated windows."
                                       HeaderIcon="{ui:FontIcon Glyph=&#xE7EF;}">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Config.RunLauncherAdmin, Mode=TwoWay}" Toggled="OnSettingChanged" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="Hide the taskbar automatically"
                                       Description="Let managed windows use the full display area."
                                       HeaderIcon="{ui:FontIcon Glyph=&#xE7F4;}">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Config.HideTaskbar, Mode=TwoWay}" Toggled="OnSettingChanged" />
                </controls:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Diagnostics" FontSize="18" FontWeight="SemiBold" Margin="2,8,0,2" />

                <controls:SettingsCard Header="Logging severity"
                                       Description="Choose how much detail is written to the diagnostic log."
                                       HeaderIcon="{ui:FontIcon Glyph=&#xE9D9;}">
                    <ComboBox SelectedValue="{x:Bind ViewModel.Config.LogLevel, Mode=TwoWay}" SelectionChanged="OnSettingChanged" Width="150">
                        <x:String>Debug</x:String>
                        <x:String>Info</x:String>
                        <x:String>Warning</x:String>
                        <x:String>Error</x:String>
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard Header="Diagnostic log file"
                                       Description="%APPDATA%\Monolith\monolith.log"
                                       HeaderIcon="{ui:FontIcon Glyph=&#xE756;}">
                    <Button Content="Open log" Click="ViewLogFile_Click" />
                </controls:SettingsCard>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
