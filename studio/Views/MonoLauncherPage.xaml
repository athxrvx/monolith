<Page
    x:Class="Monolith.Studio.Views.MonoLauncherPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,40,40">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="MonoLauncher" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Customize the Monolith application launcher." FontSize="14" Opacity="0.72" />
            </StackPanel>
            <controls:SettingsCard Header="Backdrop material" Description="Choose Acrylic or a fully opaque OLED black surface." HeaderIcon="{ui:FontIcon Glyph=&#xE7F4;}">
                <ComboBox x:Name="MaterialCombo" Width="220">
                    <x:String>Acrylic (Frosted Glass)</x:String>
                    <x:String>Pure OLED Dark</x:String>
                </ComboBox>
            </controls:SettingsCard>
            <controls:SettingsCard Header="Launcher width" Description="Set the launcher width as a percentage of the active monitor." HeaderIcon="{ui:FontIcon Glyph=&#xE7F4;}">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Slider x:Name="WidthSlider" Width="200" Minimum="40" Maximum="90" StepFrequency="1" />
                    <TextBlock x:Name="WidthValue" Foreground="{StaticResource AccentBlueBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </controls:SettingsCard>
            <controls:SettingsCard Header="Launcher height" Description="Set the launcher height as a percentage of the active monitor." HeaderIcon="{ui:FontIcon Glyph=&#xE7F4;}">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Slider x:Name="HeightSlider" Width="200" Minimum="65" Maximum="95" StepFrequency="1" />
                    <TextBlock x:Name="HeightValue" Foreground="{StaticResource AccentBlueBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
