<Window
    x:Class="Monolith.Studio.MonobarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Monobar">
    <Border x:Name="BarSurface" Background="#001C1C1C" BorderBrush="#28FFFFFF"
            BorderThickness="0,0,0,1" Padding="12,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="LeftModules" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center" HorizontalAlignment="Left" />
            <StackPanel x:Name="CenterModules" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center" HorizontalAlignment="Center" />
            <StackPanel x:Name="RightModules" Grid.Column="2" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
    </Border>
</Window>
