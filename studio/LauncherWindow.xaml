<Window
    x:Class="Monolith.Studio.LauncherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Monolith.Studio"
    Title="Monolith Search">
    <Border x:Name="LauncherSurface"
            Background="#E61C1C1C"
            BorderBrush="#30FFFFFF"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14">
        <Border.Resources>
            <SolidColorBrush x:Key="SurfaceHigherBrush" Color="#383838" />
            <SolidColorBrush x:Key="GroupSurfaceBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="GroupSurfaceBorderBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="LauncherSecondaryTextBrush" Color="#D4D4D4" />
            <SolidColorBrush x:Key="LauncherTertiaryTextBrush" Color="#A8A8A8" />
        </Border.Resources>
        <Grid x:Name="LauncherRoot" RowSpacing="10" KeyDown="Root_KeyDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="SearchHeader" Grid.Row="0" Margin="2,0,8,0"
                    Background="#26262626" BorderBrush="#30FFFFFF"
                    BorderThickness="1" CornerRadius="9" Padding="14,0">
                <Border.Resources>
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </Border.Resources>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE721;" FontSize="18" Foreground="{StaticResource AccentBlueBrush}"
                              VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" Height="32" MinHeight="32" FontSize="14"
                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                             TextWrapping="Wrap" AcceptsReturn="False"
                             Padding="0,4,0,0" BorderThickness="0" BorderBrush="Transparent"
                             FocusVisualPrimaryBrush="Transparent" FocusVisualSecondaryBrush="Transparent"
                             Background="Transparent"
                             PlaceholderText="Search applications and settings"
                             TextChanged="SearchBox_TextChanged" KeyDown="Root_KeyDown"
                             GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus"
                             AutomationProperties.Name="Search applications and settings" />
                    <Button Grid.Column="2" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                            Background="Transparent" BorderThickness="0" Click="CloseLauncher_Click"
                            AutomationProperties.Name="Close launcher" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="ContentScrollViewer" VerticalScrollMode="Auto"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="LauncherContent" Spacing="16" Padding="2,2,8,12">
                        <Border x:Name="ApplicationsSection" CornerRadius="10" Padding="10"
                                Background="{StaticResource GroupSurfaceBrush}"
                                BorderBrush="{StaticResource GroupSurfaceBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AppsHeading" Text="Applications" FontSize="16"
                                           FontWeight="SemiBold" Margin="4,0,0,0" />
                                <TextBlock x:Name="AppsCountText" Grid.Column="1" FontSize="11"
                                           Foreground="{StaticResource LauncherTertiaryTextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button x:Name="AppsExpandButton" Grid.Column="2" Padding="8,5"
                                        Click="AppsExpandButton_Click" Background="Transparent"
                                        BorderThickness="0" Visibility="Collapsed">
                                    <TextBlock x:Name="AppsExpandLabel" Text="Show all"
                                               Foreground="{StaticResource AccentBlueBrush}" FontSize="12" />
                                </Button>
                            </Grid>
                            <GridView x:Name="AppsGrid" Height="120" IsItemClickEnabled="True"
                                      ItemClick="AppsGrid_ItemClick" SelectionMode="None"
                                      Background="Transparent" BorderThickness="0" Padding="0"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      KeyDown="Root_KeyDown">
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="2" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </GridView.ItemContainerStyle>
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal"
                                                        ItemWidth="100" ItemHeight="104" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="local:LauncherResult">
                                        <Border HorizontalAlignment="Stretch" Height="96" CornerRadius="8" Padding="4"
                                                Background="{x:Bind SelectionBackgroundBrush, Mode=OneWay}"
                                                BorderBrush="{x:Bind SelectionBorderBrush, Mode=OneWay}"
                                                BorderThickness="1">
                                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                                <Border Width="40" Height="40" CornerRadius="11"
                                                        Background="{StaticResource SurfaceHigherBrush}"
                                                        HorizontalAlignment="Center">
                                                    <Grid>
                                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="27"
                                                                  Foreground="{StaticResource LauncherSecondaryTextBrush}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Stretch="Uniform" Loaded="ResultIcon_Loaded" Margin="5" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{x:Bind Title}" FontSize="11" FontWeight="SemiBold"
                                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           TextWrapping="Wrap" MaxLines="2" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                        </Border>

                        <ItemsControl x:Name="GroupsPanel">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:LauncherResultGroup">
                                    <Border CornerRadius="10" Padding="10" Margin="0,0,0,16"
                                            Background="{StaticResource GroupSurfaceBrush}"
                                            BorderBrush="{StaticResource GroupSurfaceBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="5">
                                        <Button Tag="{x:Bind}" Click="GroupHeader_Click" Padding="10,7"
                                                IsEnabled="{x:Bind CanExpand}"
                                                HorizontalContentAlignment="Stretch" Background="Transparent"
                                                BorderThickness="0">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind CountLabel}"
                                                           FontSize="11" Foreground="{StaticResource LauncherTertiaryTextBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind ExpandLabel, Mode=OneWay}"
                                                           Visibility="{x:Bind ExpandVisibility}"
                                                           FontSize="11" Foreground="{StaticResource LauncherSecondaryTextBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                        <ItemsControl ItemsSource="{x:Bind VisibleResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:LauncherResult">
                                                    <Button Tag="{x:Bind}" Click="ResultButton_Click" Padding="0"
                                                            Margin="2,1" HorizontalContentAlignment="Stretch"
                                                            Background="Transparent" BorderThickness="0" CornerRadius="8">
                                                        <Border CornerRadius="8" Padding="10,6"
                                                                BorderThickness="1"
                                                                BorderBrush="{x:Bind SelectionBorderBrush, Mode=OneWay}"
                                                                Background="{x:Bind SelectionBackgroundBrush, Mode=OneWay}">
                                                            <Grid ColumnSpacing="12" MinHeight="48">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="42" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="36" Height="36" CornerRadius="9"
                                                                        Background="{StaticResource SurfaceHigherBrush}"
                                                                        VerticalAlignment="Center">
                                                                    <Grid>
                                                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18"
                                                                                  Foreground="{StaticResource LauncherSecondaryTextBrush}"
                                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        <Image Stretch="Uniform" Loaded="ResultIcon_Loaded" Margin="4" />
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{x:Bind Description}" Visibility="{x:Bind DescriptionVisibility}"
                                                                               FontSize="11" Foreground="{StaticResource LauncherTertiaryTextBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel x:Name="EmptyState" Visibility="Collapsed" Spacing="10"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <FontIcon x:Name="EmptyStateIcon" Glyph="&#xE721;" FontSize="28" Opacity="0.65"
                              HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyStateText" Text="No matches" Opacity="0.72" FontSize="14"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid x:Name="LauncherFooter" Grid.Row="2" ColumnSpacing="14" Padding="6,4,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ResultCountText" VerticalAlignment="Center"
                           Foreground="{StaticResource LauncherTertiaryTextBrush}" FontSize="11" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <TextBlock Text="↑↓ Navigate" Foreground="{StaticResource LauncherTertiaryTextBrush}" FontSize="10" />
                    <TextBlock Text="↵ Open" Foreground="{StaticResource LauncherTertiaryTextBrush}" FontSize="10" />
                    <TextBlock Text="Esc Close" Foreground="{StaticResource LauncherTertiaryTextBrush}" FontSize="10" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
