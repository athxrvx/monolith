<Window
    x:Class="Monolith.Studio.LauncherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Monolith.Studio"
    Title="Launcher">
    <Border Background="#E51F1F1F"
            BorderBrush="#38FFFFFF"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,12,14,9">
        <Grid RowSpacing="8" KeyDown="Root_KeyDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <AutoSuggestBox x:Name="SearchBox"
                            Grid.Row="0"
                            Height="40"
                            FontSize="15"
                            PlaceholderText="Search apps and tools"
                            TextChanged="SearchBox_TextChanged"
                            QuerySubmitted="SearchBox_QuerySubmitted"
                            KeyDown="Root_KeyDown">
                <AutoSuggestBox.QueryIcon>
                    <SymbolIcon Symbol="Find" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>

            <Grid Grid.Row="1">
                <ListView x:Name="ResultsList"
                          IsItemClickEnabled="True"
                          ItemClick="ResultsList_ItemClick"
                          SelectionMode="Single"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollMode="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          KeyDown="Root_KeyDown">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="48" />
                            <Setter Property="Padding" Value="6,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:LauncherResult">
                            <Grid ColumnSpacing="9" Padding="3,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="26" Height="26" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="17" Foreground="#55D6E2"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Stretch="Uniform" Loaded="ResultIcon_Loaded" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="10" Opacity="0.62"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind Category}" FontSize="10" Opacity="0.55"
                                           VerticalAlignment="Center" Margin="8,0,6,0" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyStateText" Text="No matches" Visibility="Collapsed"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Opacity="0.58" FontSize="12" />
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ResultCountText" VerticalAlignment="Center" Opacity="0.55" FontSize="12" />
                <TextBlock Grid.Column="1" Text="↑ ↓ Navigate   Enter Open   Esc Close"
                           VerticalAlignment="Center" Opacity="0.55" FontSize="10" />
            </Grid>
        </Grid>
    </Border>
</Window>
